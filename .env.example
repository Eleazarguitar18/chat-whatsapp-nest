# ==========================================================================
# Servidor
# ==========================================================================
PORT=3000

# ==========================================================================
# WhatsApp / Baileys
# ==========================================================================
# Carpeta donde se guarda la sesión de Baileys
AUTH_FOLDER_NAME=auth_info_baileys

# ==========================================================================
# Swagger (Basic Auth para /docs y /docs-json)
# ==========================================================================
SWAGGER_USER=admin
SWAGGER_PASS=admin123

# ==========================================================================
# Integraciones externas
# ==========================================================================
ELEVENLABS_API_KEY=tu_api_key_de_elevenlabs

# ==========================================================================
# Webhook de GitLab -> WhatsApp
# ==========================================================================
# Secret Token a configurar en GitLab (Settings > Webhooks > Secret token).
# Si se deja vacío, el endpoint /api/webhooks/gitlab queda sin verificación.
GITLAB_WEBHOOK_SECRET=cambia-este-token-secreto

# Destinatario de las notificaciones.
# Puede ser un JID de grupo (120363...@g.us), un JID individual
# (59171234567@s.whatsapp.net) o un número con código de país (59171234567).
GITLAB_NOTIFY_TO=120363000000000000@g.us
